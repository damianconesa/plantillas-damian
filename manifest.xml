<?xml version="1.0" encoding="UTF-8"?>
<!--
  Complemento "Plantillas para Damián"
  ANTES DE DESPLEGAR: sustituye https://damianconesa.github.io/plantillas-damian por la URL real donde publiques la carpeta
  (aparece en IconUrl, HighResolutionIconUrl, SupportUrl, AppDomain, FormSettings y en Resources).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>04f58496-b598-4d4c-80e5-3eca2b5cfc02</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Alvores IT</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Plantillas para Damián"/>
  <Description DefaultValue="Al escribir a Damián Conesa, ofrece dos plantillas para redactar la solicitud."/>
  <IconUrl DefaultValue="https://damianconesa.github.io/plantillas-damian/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://damianconesa.github.io/plantillas-damian/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://damianconesa.github.io/plantillas-damian/index.html"/>
  <AppDomains>
    <AppDomain>https://damianconesa.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://damianconesa.github.io/plantillas-damian/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.11">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Entorno ligero donde se ejecuta la detección del destinatario -->
          <Runtimes>
            <!-- HTML: Outlook web, nuevo Outlook para Windows y Mac -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- JS: Outlook clásico para Windows -->
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <!-- Botón en la cinta al redactar (también se puede abrir a mano) -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="grpPlantillasDamian">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="btnPlantillasDamian">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Detección automática: al añadir destinatarios y al abrir un correo nuevo/respuesta -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onRecipientsChanged"/>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageCompose"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://damianconesa.github.io/plantillas-damian/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://damianconesa.github.io/plantillas-damian/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://damianconesa.github.io/plantillas-damian/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://damianconesa.github.io/plantillas-damian/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://damianconesa.github.io/plantillas-damian/taskpane.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://damianconesa.github.io/plantillas-damian/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://damianconesa.github.io/plantillas-damian/launchevent.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Damián"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Plantillas para Damián"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Abre las plantillas para enviar una solicitud a Damián."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
